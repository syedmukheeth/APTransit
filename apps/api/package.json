{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "WORKER=1 nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node -e \"console.error('The seed is built on Day 2, see prompts/day-02.md');process.exit(1)\"",
    "db:reset": "node -e \"console.error('db:reset is built on Day 2, see prompts/day-02.md');process.exit(1)\""
  },
  "dependencies": {
    "@aptransit/shared": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aptransit/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
